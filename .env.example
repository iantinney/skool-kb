# Copy this file to .env and fill in what you need. .env is gitignored.

# ─── Optional: fast cloud transcription via Groq ─────────────────────
# Only needed if some of your videos have NO captions (Loom, Vimeo, a few
# YouTube). Get a free key at https://console.groq.com/keys
# Without this, transcription falls back to local faster-whisper on CPU.
GROQ_API_KEY=

# ─── Optional: local Whisper model size (used only when GROQ_API_KEY is unset) ─
# tiny | base | small | medium | large-v3   (bigger = slower but more accurate)
# Default is "small". On a CPU-only machine, "base" is a good speed/quality pick.
# WHISPER_MODEL=small

# ─── Optional: how many feed pages to paginate per community ─────────
# PAGES=30
